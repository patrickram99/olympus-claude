# Olympus CRM connection
# Copia este archivo a .env y completa con tus credenciales reales.
# Proveedor de BD: mssql (actual) | postgres (post-migración, aún stub)
# Todo lo específico del proveedor (TLS/certificados incluidos) vive en lib/db_backends/<dialecto>.py
DB_DIALECT=mssql
DB_SERVER=tu-servidor.database.windows.net
DB_PORT=1433
DB_NAME=olympus
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERT=yes

# Defaults para el modelo de costos (puedes overridear via CLI args)
USD_PEN_RATE=3.78
SALARIO_BASE_PEN=565
CPL_USD=0.20
COMISION_ASESOR_PCT=0.10
COMISION_ADMIN_PCT=0.10
DOCENTE_USD=1440

# Fecha de inicio de los datos de ventas en el CRM.
# Personal.FechaIngreso para ~48% de asesores activos es pre-CRM (algunos
# desde 2005). Para análisis de TTFS / cohort / ramp-up, la fecha se trunca
# a MAX(real, este valor) por default ("sales mode").
# Para análisis HR/rotación, pasar --hr-mode al script para usar la real.
SALES_DATA_START_DATE=2026-01-01
